{
  "name": "@pokecard/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --enable-source-maps dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "pnpm run test:fast",
    "test:fast": "vitest run tests/basic.test.ts tests/integration.test.ts tests/recognize-text.test.ts",
    "test:integration": "node scripts/run-db-integration-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:pokemontcg": "node scripts/seed-pokemontcg.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@pokecard/shared": "workspace:*",
    "@prisma/client": "^5.18.0",
    "reflect-metadata": "^0.2.2",
    "redis": "^4.7.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.0"
  },
  "optionalDependencies": {
    "opencv4nodejs": "^5.6.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.7",
    "@types/node": "^20.11.30",
    "@types/supertest": "^6.0.3",
    "prisma": "^5.18.0",
    "supertest": "^7.1.4",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
