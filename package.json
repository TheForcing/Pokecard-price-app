{
  "name": "pokecard-price-app",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm run test:fast",
    "test:fast": "pnpm -C packages/shared test && pnpm -C apps/web test && pnpm -C apps/api test:fast",
    "test:integration": "pnpm -C apps/api test:integration",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier -w .",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^8.57.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
